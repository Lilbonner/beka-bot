# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Путь к файлу базы SQLite
DB_PATH=./data/beks.db

# ID целевого чата (узнать командой /chatid). Дефолт для импорта истории.
CHAT_ID=

# Вероятность, что бот сам встрянет в случайное сообщение (0..1)
TRIGGER_PROBABILITY=0.07

# Минимум сообщений, чтобы ушедший участник стал «призраком»
MIN_MESSAGES=20

# Вероятность дословной цитаты вместо сгенерированной фразы (0..1)
VERBATIM_PROBABILITY=0.4

# Порядок цепи Маркова: 1 — хаотичнее/смешнее, 2 — связнее
MARKOV_ORDER=2

# Максимум слов во фразе призрака
MARKOV_MAX_WORDS=40

# Показывать имя призрака перед фразой (true/false)
SHOW_GHOST_NAME=true

# Если в чате тишина дольше N минут — бот сам пишет фразу призрака (0 = выключено)
IDLE_MINUTES=60
